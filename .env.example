# Lead delivery. At least one channel must be set, or submissions are lost:
# the visitor still sees a success message and the lead only reaches the log.

# Option A (optional backup channel): Google Apps Script web app /exec URL,
# which appends each lead to a Google Sheet. Worth keeping alongside the
# database as a safety net — a paused Supabase project cannot lose leads if a
# second channel is live. See docs/lead-sheet.gs.
LEAD_WEBHOOK_URL=

# Option B (recommended): Postgres via Drizzle. Schema lives in
# lib/db/schema.ts — run `npm run db:push` after changing it.
# DATABASE_URL is the POOLED url (Supabase: Connect → Transaction pooler, :6543).
# DIRECT_URL is the direct connection (:5432) and is used by migrations only.
# Neither may be prefixed NEXT_PUBLIC_.
DATABASE_URL=
DIRECT_URL=

# Option C: email via Resend. Both are required for the channel to be used.
# LEAD_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Admin panel at /admin. Unset = the admin area 404s entirely rather than
# existing with an empty password. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Changing it signs every open session out.
ADMIN_PASSWORD=

# Search engine ownership verification (optional). Paste the token from
# Search Console → Settings → Ownership verification → HTML tag (the content
# attribute only), and the Bing Webmaster equivalent. Rendered as <meta> tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
